# Required public storefront values
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
NEXT_PUBLIC_STORE_NAME="Your Store Name"
NEXT_PUBLIC_STORE_SLUG="your-store-slug"
NEXT_PUBLIC_STORE_BRAND_MARK="YOUR BRAND"
NEXT_PUBLIC_STORE_CONTACT_EMAIL="contact@example.com"
NEXT_PUBLIC_SUPABASE_AUTH_STORAGE_KEY="your-store.supabase.auth"

# Optional public storefront values
NEXT_PUBLIC_STORE_TAGLINE="Optional storefront tagline"
NEXT_PUBLIC_STORE_CONTACT_PHONE=""
NEXT_PUBLIC_STORE_INSTAGRAM_URL=""
NEXT_PUBLIC_STORE_FACEBOOK_URL=""

# App
APP_BASE_URL="http://localhost:3000"

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN="your-mercadopago-access-token"
MERCADOPAGO_WEBHOOK_SECRET="your-mercadopago-webhook-secret"
MP_WEBHOOK_DEV_MODE="0"
MP_WEBHOOK_ALLOW_LOOKUP_FALLBACK="0"
MP_WEBHOOK_MAX_SIGNATURE_AGE_SECONDS="300"
