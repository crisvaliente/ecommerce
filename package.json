{
  "name": "ecommerce",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.2.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test:instance-config": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/instance-config.test.mjs",
    "test:checkout-idempotency": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test scripts/checkout-idempotency.test.mjs",
    "test:checkout-idempotency:db": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test scripts/checkout-idempotency-db.test.mjs",
    "bootstrap:instance": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bootstrap-instance.mjs",
    "seed:optional": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bootstrap-instance.mjs --seed",
    "smoke:bootstrap": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/bootstrap-smoke-users.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
    "framer-motion": "^12.9.1",
    "next": "16.1.1",
