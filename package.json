    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "tailwind-variants": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.1.7",
    "postcss": "^8",
    "supabase": "2.67.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
